# Database
DATABASE_URL=postgresql://postgres:password@hate.local:5432/home_aid_kit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=home_aid_kit

# Redis
REDIS_URL=redis://hate.local:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs
DRLZ_BASE_URL=http://www.drlz.com.ua
TABLETKI_BASE_URL=https://tabletki.ua

# Rate limiting
REQUESTS_PER_SECOND=1
REQUESTS_PER_MINUTE_PER_HOUSEHOLD=10

# Celery
CELERY_BROKER_URL=redis://hate.local:6379/1
CELERY_RESULT_BACKEND=redis://hate.local:6379/2

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
